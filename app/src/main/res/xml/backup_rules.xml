<?xml version="1.0" encoding="utf-8"?>
<!-- The saved queue names media index IDs and files, which mean nothing after a restore on another device; "stop after
     current track" belongs to that queue. Crash reports stay on the device they come from. -->
<full-backup-content>
    <exclude
        domain="file"
        path="datastore/playback_state.preferences_pb" />
    <exclude
        domain="sharedpref"
        path="playback_controls.xml" />
    <exclude
        domain="file"
        path="crashes/" />
</full-backup-content>
