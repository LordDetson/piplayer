<?xml version="1.0" encoding="utf-8"?>
<!-- What a backup takes (docs/library.md §3.3): the user database and the settings file. Everything else stays on the
     device: the library database, which is rebuilt, the per-device state, the saved queue, crash reports and caches. -->
<full-backup-content>
    <include
        domain="database"
        path="user.db" />
    <include
        domain="database"
        path="user.db-wal" />
    <include
        domain="file"
        path="datastore/settings.preferences_pb" />
</full-backup-content>
