<?xml version="1.0" encoding="utf-8"?>
<!-- The saved queue names media index IDs and files, which mean nothing after a restore on another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="datastore/playback_state.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/playback_state.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
